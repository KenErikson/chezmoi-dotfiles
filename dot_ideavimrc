let mapleader=" "

set surround          " Enables changing/adding/deleting brackets and quotes (e.g., `cs"'` changes quotes).
set multiple-cursors  " Enables Sublime Text-like multiple cursors.
set commentary        " Enables quick commenting/uncommenting with `gc`.
set argtextobj        " Adds an 'argument' text object (e.g., `dia` deletes an argument inside a function).
set easymotion        " Enables rapid jumping around the screen.
set textobj-entire    " Adds an 'entire file' text object (e.g., `yie` yanks the whole file).
set ReplaceWithRegister " Lets you replace text with copied text without overwriting your clipboard (`gr`).
set exchange          " Lets you easily swap two pieces of text (`cx`).
Plug 'machakann/vim-highlightedyank' " Briefly highlights text when you copy (yank) it so you have visual feedback.

set showmode  " Shows your current Vim mode (INSERT, VISUAL, etc.) at the bottom of the screen.
set so=5      " 'scrolloff=5'. Keeps 5 lines of context visible above and below your cursor when scrolling.
set incsearch " Highlights search matches instantly as you are typing your query.
set nu        " 'number'. Turns on line numbers in the gutter.

set ideajoin
" set ideastatusicon=gray

